    "mobile_legible_ratio_fail": 0.6,
    "tap_target_min_px": 44,
    "tap_target_fail_ratio_warn": 0.05,
    "tap_target_fail_ratio_fail": 0.15,
    "horizontal_scroll_tolerance_px": 8,
    "ai_design_pass": 70,
    "ai_design_fail_below": 45,
    "pagespeed_pass": 90,
    "pagespeed_fail_below": 50,
    "large_image_bytes": 300000,
    "huge_image_bytes": 1000000,
    "oversized_image_ratio": 2.5,
    "oversized_image_min_px": 1200,
    "page_weight_warn_bytes": 2500000,
    "page_weight_fail_bytes": 5000000,
