  "limits": {
    "max_html_bytes": 5000000,
    "max_redirects": 8,
    "max_internal_links_checked": 15,
    "max_external_links_checked": 8,
    "max_images_checked_without_browser": 12,
    "max_dom_elements_measured": 1500
