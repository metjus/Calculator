  "browser": {
    "enabled": true,
    "desktop_viewport": {"width": 1366, "height": 900},
    "mobile_viewport": {"width": 390, "height": 844},
    "narrow_desktop_width": 700,
    "network_idle_wait_ms": 3000,
    "block_media": true
  },
