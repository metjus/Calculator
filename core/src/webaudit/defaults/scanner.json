{
  "_comment": "Scanner behaviour and check thresholds. Edit freely; keys you leave out keep their default.",
  "user_agent_token": "WebAuditBot",
  "user_agent_info_url": "https://example.com/webauditbot",
  "accept_language": "sk,cs;q=0.9,en;q=0.8",
