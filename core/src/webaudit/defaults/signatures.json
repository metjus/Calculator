  "libraries": [
    {
      "name": "jQuery",
      "url_regex": [
        "jquery[.-](\\d+\\.\\d+(?:\\.\\d+)?)(?:\\.slim)?(?:\\.min)?\\.js",
        "/jquery/(\\d+\\.\\d+\\.\\d+)/",
        "jquery@(\\d+\\.\\d+\\.\\d+)",
        "jquery(?:\\.min)?\\.js\\?ver=(\\d+\\.\\d+\\.\\d+)"
      ],
      "runtime": "jquery",
      "fail_below": "3.5.0",
      "warn_below": "3.7.0"
    },
    {
      "name": "jQuery UI",
      "url_regex": [
        "jquery-ui[.-](\\d+\\.\\d+\\.\\d+)",
        "/jqueryui/(\\d+\\.\\d+\\.\\d+)/",
        "jquery-ui(?:\\.min)?\\.js\\?ver=(\\d+\\.\\d+\\.\\d+)"
      ],
      "runtime": "jqueryui",
      "fail_below": "1.13.0"
    },
    {
      "name": "jQuery Migrate",
      "url_regex": [
        "jquery-migrate[.-](\\d+\\.\\d+\\.\\d+)"
      ],
      "warn_below": "3.0.0"
    },
    {
      "name": "Bootstrap",
      "url_regex": [
        "bootstrap[.-](\\d+\\.\\d+\\.\\d+)(?:\\.bundle)?(?:\\.min)?\\.(?:js|css)",
        "/bootstrap/(\\d+\\.\\d+\\.\\d+)/",
        "bootstrap@(\\d+\\.\\d+\\.\\d+)"
      ],
      "runtime": "bootstrap",
      "fail_below": "3.4.1",
      "warn_below": "4.0.0"
    },
    {
      "name": "AngularJS",
      "url_regex": [
        "angular[.-](1\\.\\d+\\.\\d+)(?:\\.min)?\\.js",
        "/angular\\.js/(1\\.\\d+\\.\\d+)/",
        "angular@(1\\.\\d+\\.\\d+)"
      ],
      "runtime": "angularjs",
      "fail_below": "2.0.0"
    },
    {
      "name": "Lodash",
      "url_regex": [
        "lodash[.-](\\d+\\.\\d+\\.\\d+)",
        "/lodash\\.js/(\\d+\\.\\d+\\.\\d+)/",
        "lodash@(\\d+\\.\\d+\\.\\d+)"
      ],
      "runtime": "lodash",
      "fail_below": "4.17.21"
    },
    {
      "name": "Moment.js",
      "url_regex": [
        "moment[.-](\\d+\\.\\d+\\.\\d+)",
        "/moment\\.js/(\\d+\\.\\d+\\.\\d+)/",
        "moment@(\\d+\\.\\d+\\.\\d+)"
      ],
      "runtime": "moment",
      "fail_below": "2.29.4",
      "warn_below": "99.0.0"
    },
    {
      "name": "Vue.js",
      "url_regex": [
        "vue@(2\\.\\d+\\.\\d+)",
        "/vue/(2\\.\\d+\\.\\d+)/"
      ],
      "runtime": "vue",
      "warn_below": "3.0.0"
    },
    {
      "name": "MooTools",
      "url_regex": [
        "mootools[.-]?(?:core)?[.-]?(\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "runtime": "mootools",
      "fail_below": "99.0.0"
    },
    {
      "name": "Prototype",
      "url_regex": [
        "prototype[.-](\\d+\\.\\d+\\.\\d+)\\.js"
      ],
      "runtime": "prototype",
      "fail_below": "99.0.0"
    },
    {
      "name": "SWFObject (Flash)",
      "url_regex": [
        "swfobject"
      ],
      "fail_below": "99.0.0"
    }
