{
  "_comment": "Detection patterns. Regexes are case-insensitive and run against HTML, header values or resource URLs. Review the CMS version limits about twice a year.",
  "cms": [
    {
      "name": "WordPress",
      "html": [
        "/wp-content/",
        "/wp-includes/"
      ],
      "generator": "wordpress",
      "version_regex": [
        "<meta[^>]+generator[^>]+WordPress (\\d+\\.\\d+(?:\\.\\d+)?)",
        "wp-(?:emoji-release|embed)\\.min\\.js\\?ver=(\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "warn_below": "6.7",
      "fail_below": "6.0"
    },
    {
      "name": "Joomla",
      "html": [
        "/media/jui/",
        "/media/system/js/",
        "/components/com_"
      ],
      "generator": "joomla",
      "version_regex": [
        "Joomla! (\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "warn_below": "5.0",
      "fail_below": "4.0"
    },
    {
      "name": "Drupal",
      "html": [
        "/sites/default/files/",
        "drupal-settings-json",
        "Drupal.settings"
      ],
      "generator": "drupal",
      "headers": {
        "x-generator": "drupal"
      },
      "version_regex": [
        "Drupal (\\d+(?:\\.\\d+)?)"
      ],
      "warn_below": "10.3",
      "fail_below": "10"
    },
    {
      "name": "Wix",
      "html": [
        "static.wixstatic.com",
        "wix-bolt",
        "_wixCIDX"
      ],
      "generator": "wix.com",
      "headers": {
        "x-wix-request-id": ""
      }
    },
    {
      "name": "Squarespace",
      "html": [
        "static1.squarespace.com",
        "squarespace-cdn.com"
      ],
      "generator": "squarespace"
    },
    {
