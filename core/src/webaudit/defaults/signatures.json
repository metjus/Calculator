  "protection": {
    "cloudflare": {
      "headers": [
        "cf-ray",
        "cf-mitigated",
        "cf-chl-bypass"
      ],
      "server": "cloudflare",
      "body": [
        "challenge-platform",
        "cf-browser-verification",
        "cf_chl_opt",
        "<title>just a moment...</title>",
        "attention required! | cloudflare",
        "checking your browser before accessing",
        "cf-error-details",
        "enable javascript and cookies to continue"
      ]
    },
    "sucuri": {
      "headers": [
        "x-sucuri-id",
        "x-sucuri-block"
      ],
      "server": "sucuri",
      "body": [
        "sucuri website firewall",
        "access denied - sucuri"
      ]
    },
    "imperva": {
      "headers": [
        "x-iinfo",
        "x-cdn: imperva"
      ],
      "server": "",
      "body": [
        "_incapsula_resource",
        "incapsula incident id"
      ]
    },
    "datadome": {
      "headers": [
        "x-datadome",
        "x-dd-b"
      ],
      "server": "",
      "body": [
